<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-theme halo: soft white glow with stronger radiance for better contrast on dark backgrounds -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="#4DFFFFFF"
        android:endColor="#00FFFFFF"
        android:gradientRadius="38dp"
        android:startColor="#B3FFFFFF"
        android:type="radial" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
