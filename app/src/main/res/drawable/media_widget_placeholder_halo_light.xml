<?xml version="1.0" encoding="utf-8"?>
<!-- Light-theme halo: subtle dark shadow glow for clean visibility on light backgrounds -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="#30000000"
        android:endColor="#00000000"
        android:gradientRadius="38dp"
        android:startColor="#80000000"
        android:type="radial" />
    <stroke
        android:width="1dp"
        android:color="#60000000" />
</shape>
