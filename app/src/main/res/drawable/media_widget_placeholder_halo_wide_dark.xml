<?xml version="1.0" encoding="utf-8"?>
<!-- Wide dark-theme halo: larger gradient radius for the wide widget layout -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="#4DFFFFFF"
        android:endColor="#00FFFFFF"
        android:gradientRadius="44dp"
        android:startColor="#B3FFFFFF"
        android:type="radial" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
