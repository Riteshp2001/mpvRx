<?xml version="1.0" encoding="utf-8"?>
<!-- Wide light-theme halo: larger gradient radius for the wide widget layout -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="#30000000"
        android:endColor="#00000000"
        android:gradientRadius="44dp"
        android:startColor="#80000000"
        android:type="radial" />
    <stroke
        android:width="1dp"
        android:color="#60000000" />
</shape>
