<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/audio_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/audio_widget_metadata"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/audio_widget_artwork"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/audio_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/audio_widget_empty"
                android:textColor="#1A1C1E"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/audio_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#505558"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/audio_widget_previous"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pref_gesture_media_previous"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#226F60" />
        <ImageButton
            android:id="@+id/audio_widget_play"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/ui_play"
            android:padding="10dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#226F60" />
        <ImageButton
            android:id="@+id/audio_widget_next"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pref_gesture_media_next"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#226F60" />
    </LinearLayout>
</LinearLayout>